[Unit]
Description=Symbiote Unified Daemon (Symbiote 3.0)
After=network.target

[Service]
Type=simple
User=adam
WorkingDirectory=/opt/ava/mach6/mach6-core
ExecStart=/usr/bin/node /opt/ava/mach6/mach6-core/dist/daemon/unified-daemon.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
