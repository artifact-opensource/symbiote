#!/usr/bin/env bash
set -euo pipefail

# Mach6 Stack Manager — Symbiote 3.0
# Updated 2026-06-12: Added restart command, improved port detection.

# Ensure user-level systemd bus is available
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

MACH6_DIR="/opt/ava/mach6"
MACH6_CORE="$MACH6_DIR/mach6-core"
CONFIG_FILE="$MACH6_DIR/symbiote.json"
ENV_FILE="/opt/ava/.env"
STACK_MANAGER="/opt/ava/stack_manager/stack_manager.py"
SC="systemctl --user"
JC="journalctl --user"

# Load environment variables if file exists
if [ -f "$ENV_FILE" ]; then
    set -a
    source "$ENV_FILE"
    set +a
fi

function start_agent() {
    # SELF-KILL GUARD
    MACH6_PID=$(pgrep -f "daemon.js.*$CONFIG_FILE" 2>/dev/null | head -1 || true)
    if [ -n "$MACH6_PID" ]; then
      CHECK_PID=$PPID
      while [ "$CHECK_PID" -gt 1 ] 2>/dev/null; do
        if [ "$CHECK_PID" = "$MACH6_PID" ]; then
          echo "🛑 BLOCKED: ava start called from within Stack Manager (self-kill prevention)"
          exit 1
        fi
        CHECK_PID=$(ps -o ppid= -p "$CHECK_PID" 2>/dev/null | tr -d ' ' || echo 0)
      done
    fi

    echo "▶️  Starting Mach6 Agent..."
    # Kill any orphan processes first
    pkill -9 -f "daemon.js.*$CONFIG_FILE" 2>/dev/null || true
    pkill -9 -f "$STACK_MANAGER" 2>/dev/null || true
    sleep 1
    
    # Launch the Mach6 Daemon
    nohup setsid /usr/bin/node "$MACH6_CORE/dist/gateway/daemon.js" --config="$CONFIG_FILE" >> /tmp/mach6.log 2>&1 &
    
    PID=$!
    disown $PID 2>/dev/null || true
    
    sleep 5

    # Verify it came up
    if pgrep -f "daemon.js.*$CONFIG_FILE" > /dev/null; then
      echo "✅ Mach6 Agent running (PID $(pgrep -f "daemon.js.*$CONFIG_FILE"))"
    else
      echo "❌ Failed to start. Checking logs..."
      tail -n 20 /tmp/mach6.log
    fi
}

function stop_agent() {
    echo "🛑 Stopping Mach6 Agent..."
    pkill -9 -f "daemon.js.*$CONFIG_FILE" 2>/dev/null || true
    pkill -9 -f "$STACK_MANAGER" 2>/dev/null || true
    echo "✅ Agent stopped"
}

case "${1:-}" in
  start)
    start_agent
    ;;

  stop)
    stop_agent
    ;;

  restart)
    stop_agent
    sleep 1
    start_agent
    ;;

  status)
    echo "📊 Mach6 Agent Status"
    echo ""
    PID=$(pgrep -f "daemon.js.*$CONFIG_FILE" || true)
    if [ -n "$PID" ]; then
      echo "🟢 Agent: ACTIVE"
      echo "PID: $PID"
      
      # Detect API Port
      PORT_API=$(grep '"apiPort"' "$CONFIG_FILE" | sed -E 's/.*: ([0-9]+).*/\1/' || echo 3006)
      if ss -tulpn | grep -q ":$PORT_API "; then
          echo "✅ API Listening on port $PORT_API"
      else
          echo "⚠️  API Port $PORT_API not listening yet"
      fi
      
      # Detect Web Port from log (since it might fallback)
      ACTUAL_WEB_PORT=$(grep "Web UI → http://0.0.0.0:" /tmp/mach6.log | tail -1 | sed -E 's/.*:([0-9]+)/\1/' || true)
      if [ -n "$ACTUAL_WEB_PORT" ] && ss -tulpn | grep -q ":$ACTUAL_WEB_PORT "; then
          echo "✅ Web UI Listening on port $ACTUAL_WEB_PORT"
          [ "$ACTUAL_WEB_PORT" != "$(grep '"webPort"' "$CONFIG_FILE" | sed -E 's/.*: ([0-9]+).*/\1/' || echo 3010)" ] && echo "   (Note: Fallback port used due to conflict)"
      else
          echo "❌ Web UI not listening"
      fi
    else
      echo "🔴 Agent: INACTIVE"
    fi
    ;;

  logs)
    tail -n "${2:-50}" /tmp/mach6.log 2>/dev/null || echo "No logs found"
    ;;

  follow)
    tail -f /tmp/mach6.log 2>/dev/null || echo "No logs found"
    ;;

  build)
    echo "🔨 Building Mach6..."
    cd "$MACH6_CORE"
    npm run build 2>&1 && echo "✅ Build OK" || { echo "❌ Build FAILED"; exit 1; }
    ;;

  health)
    MODE="${2:-awake}"
    if [ "$MODE" != "awake" ] && [ "$MODE" != "sleep" ]; then
      echo "Usage: ava health <awake|sleep>"
      exit 1
    fi
    exec bash /home/adam/workspace/.pulse/health.sh "$MODE"
    ;;

  sovereign)
    case "${2:-status}" in
      status) /home/adam/workspace/projects/sovereign/watchdog.sh status ;;
      test) /home/adam/workspace/projects/sovereign/watchdog.sh test-flip ;;
      restart)
        echo "🔄 Restarting Sovereign Watchdog..."
        $SC restart sovereign-watchdog.service 2>/dev/null || true
        sleep 1
        [ "$($SC is-active sovereign-watchdog.service 2>/dev/null || true)" = "active" ] && echo "✅ Watchdog running" || echo "❌ Watchdog failed"
        ;;
      stop)
        echo "🛑 Stopping Sovereign Watchdog..."
        $SC stop sovereign-watchdog.service 2>/dev/null || true
        echo "✅ Watchdog stopped"
        ;;
      start)
        echo "▶️  Starting Sovereign Watchdog..."
        $SC start sovereign-watchdog.service 2>/dev/null || true
        sleep 1
        [ "$($SC is-active sovereign-watchdog.service 2>/dev/null || true)" = "active" ] && echo "✅ Watchdog running" || echo "❌ Watchdog failed"
        ;;
      logs)
        tail -n "${3:-50}" /home/adam/workspace/.pulse/sovereign-watchdog.log 2>/dev/null || echo "No logs found"
        ;;
      activate)
        echo "🛡️ Manually activating sovereign mode..."
        /home/adam/workspace/projects/sovereign/sovereign.sh start 2>/dev/null || true
        ;;
      deactivate)
        echo "🌐 Manually deactivating sovereign mode..."
        /home/adam/workspace/projects/sovereign/sovereign.sh stop 2>/dev/null || true
        ;;
      *)
        echo "Usage: ava sovereign <status|test|start|stop|restart|logs [N]|activate|deactivate>"
        ;;
    esac
    ;;

  pulse)
    PULSE_SERVICE="pulse.service"
    PSC="sudo systemctl"
    case "${2:-status}" in
      restart)
        echo "🔄 Restarting PULSE..."
        $PSC restart "$PULSE_SERVICE" 2>/dev/null || true
        sleep 1
        [ "$($PSC is-active "$PULSE_SERVICE" 2>/dev/null || true)" = "active" ] && echo "✅ PULSE running" || echo "❌ PULSE failed"
        ;;
      stop)
        echo "🛑 Stopping PULSE..."
        $PSC stop "$PULSE_SERVICE" 2>/dev/null || true
        echo "✅ PULSE stopped"
        ;;
      start)
        echo "▶️  Starting PULSE..."
        $PSC start "$PULSE_SERVICE" 2>/dev/null || true
        sleep 1
        [ "$($PSC is-active "$PULSE_SERVICE" 2>/dev/null || true)" = "active" ] && echo "✅ PULSE running" || echo "❌ PULSE failed"
        ;;
      status)
        ENTERPRISE="/home/adam/workspace"
        echo "📊 PULSE Status"
        echo ""
        STATUS=$($PSC is-active "$PULSE_SERVICE" 2>/dev/null || true)
        if [ "$STATUS" = "active" ]; then
          echo "🟢 Service: ACTIVE"
          $PSC status "$PULSE_SERVICE" 2>&1 | head -8
        else
          echo "🔴 Service: INACTIVE"
        fi
        ;;
      logs)
        journalctl -u "$PULSE_SERVICE" --no-pager -n "${3:-50}" --output=short-iso 2>/dev/null || echo "No logs found"
        ;;
      *)
        echo "Usage: ava pulse <restart|stop|start|status|logs [N]|follow>"
        ;;
    esac
    ;;

  singularity)
    SING_SERVICE="singularity.service"
    case "${2:-status}" in
      restart)
        pkill -9 -f "python3 -m singularity" 2>/dev/null || true
        sleep 4
        PROCS=$(pgrep -cf "python3 -m singularity" 2>/dev/null || echo 0)
        if [ "$PROCS" -ge 1 ]; then
          echo "✅ Singularity running"
        else
          echo "❌ No process came back"
        fi
        ;;
      stop)
        $SC stop "$SING_SERVICE" 2>/dev/null || true
        pkill -9 -f "python3 -m singularity" 2>/dev/null || true
        echo "✅ Stopped"
        ;;
      start)
        pkill -9 -f "python3 -m singularity" 2>/dev/null || true
        sleep 1
        $SC start "$SING_SERVICE" 2>/dev/null || true
        sleep 3
        [ "$($SC is-active "$SING_SERVICE" 2>/dev/null || true)" = "active" ] && echo "✅ Singularity running" || echo "❌ Singularity failed"
        ;;
      status)
        echo "📊 Singularity Status"
        echo ""
        STATUS=$($SC is-active "$SING_SERVICE" 2>/dev/null || true)
        if [ "$STATUS" = "active" ]; then
          echo "🟢 Service: ACTIVE"
          $SC status "$SING_SERVICE" 2>&1 | head -10
        else
          echo "🔴 Service: INACTIVE"
        fi
        ;;
      *)
        echo "Usage: ava singularity <restart|stop|start|status|logs [N]|follow>"
        ;;
    esac
    ;;

  webapp)
    WEBAPP_DIR="/opt/ava/mach6/mach6-core/webapp"
    case "${2:-status}" in
      start)
        echo "▶️  Starting Symbiote Dashboard..."
        pkill -f "node dist/server.cjs" 2>/dev/null || true
        sleep 1
        cd "$WEBAPP_DIR"
        nohup node dist/server.cjs > /tmp/symbiant.log 2>&1 &
        sleep 3
        if pgrep -f "node dist/server.cjs" > /dev/null; then
          echo "✅ Symbiote Dashboard running on http://0.0.0.0:3010"
        else
          echo "❌ Failed to start. Check /tmp/symbiant.log"
        fi
        ;;
      stop)
        echo "🛑 Stopping Symbiote Dashboard..."
        pkill -f "node dist/server.cjs" 2>/dev/null || true
        echo "✅ Dashboard stopped"
        ;;
      restart)
        pkill -f "node dist/server.cjs" 2>/dev/null || true
        sleep 1
        cd "$WEBAPP_DIR"
        nohup node dist/server.cjs > /tmp/symbiant.log 2>&1 &
        sleep 3
        if pgrep -f "node dist/server.cjs" > /dev/null; then
          echo "✅ Symbiote Dashboard running on http://0.0.0.0:3010"
        else
          echo "❌ Failed to restart"
        fi
        ;;
      status)
        PID=$(pgrep -f "node dist/server.cjs" || true)
        if [ -n "$PID" ]; then
          echo "🟢 Symbiote Dashboard: ACTIVE (PID $PID)"
          echo "   URL: http://0.0.0.0:3010"
        else
          echo "🔴 Symbiote Dashboard: INACTIVE"
        fi
        ;;
      build)
        echo "🔨 Building Symbiote Dashboard..."
        cd "$WEBAPP_DIR"
        npm run build 2>&1 && echo "✅ Build OK" || { echo "❌ Build FAILED"; exit 1; }
        ;;
      *)
        echo "Usage: ava webapp <start|stop|restart|status|build>"
        ;;
    esac
    ;;
  *)
    echo "Usage: ava <command>"
    echo ""
    echo "Commands:"
    echo "  start      Start Mach6 Agent"
    echo "  stop       Stop Mach6 Agent"
    echo "  restart    Restart Mach6 Agent"
    echo "  status     Show Agent status"
    echo "  logs [N]   Show last N log lines (default 50)"
    echo "  follow     Follow live logs"
    echo "  build      Compile TypeScript"
    echo ""
    echo "  health awake|sleep"
    echo "             Full system physical"
    echo ""
    echo "  pulse restart|stop|start|status|logs"
    echo "             Manage PULSE consciousness loop"
    echo ""
    echo "  singularity restart|stop|start|status|logs"
    echo "             Manage Singularity [AE] runtime"
    echo ""
    echo "  sovereign status|test|start|stop|restart|logs"
    echo "             Manage Sovereign Watchdog"
    ;;
esac
