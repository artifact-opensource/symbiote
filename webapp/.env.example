# Symbiote Dashboard Environment Variables
# Copy to .env and fill in values

# Google Gemini API key (optional — enables Gemini image fallback + chat)
GEMINI_API_KEY=

# Server port (default: 3010)
PORT=3010

# Mach6 Gateway URL (default: http://127.0.0.1:3006)
GATEWAY_URL=http://127.0.0.1:3006

# Mach6 API key (optional)
MACH6_API_KEY=

# Node environment (production enables static file serving)
NODE_ENV=production
