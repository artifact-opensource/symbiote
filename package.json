{
  "name": "@symbiote-agi/symbiote",
  "version": "5.6.1",
  "description": "Super-Agent, at scale",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "symbiote": "dist/index.js"
  },
  "files": [
    "dist",
    "web",
    "webapp/dist",
    "desktop",
    "scripts/start-desktop.mjs",
    "scripts/windows/stop-symbiote.ps1",
    "scripts/windows/update-symbiote.ps1",
    "skills/cron-autonomy",
    "README.md",
    "CHANGELOG.md",
    "RELEASES.md",
    "RELEASE_NOTES_v5.6.1.md",
    "RELEASE_NOTES_v5.5.0.md",
    "LICENSE",
    "symbiote.example.json",
    "symbiote.schema.json",
    ".env.example",
    "symbiote.sh",
    "symbiote.ps1",
    "symbiote-gateway.service",
    "install.sh",
    "install.ps1",
    "install.command",
    "install.cmd"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc && npm --prefix webapp run build && node scripts/copy-runtime-assets.mjs",
    "build:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-msi.ps1",
    "desktop": "node scripts/start-desktop.mjs",
    "dev:webapp": "npm --prefix webapp run dev",
    "build:webapp": "npm --prefix webapp run build",
    "index:codebase": "node scripts/generate-codebase-index.mjs",
    "start": "node scripts/start-desktop.mjs",
    "dev": "tsc && node dist/index.js",
    "init": "tsc && node dist/cli/wizard.js"
  },
  "keywords": [
    "ai-agent",
    "ai-agent-framework",
    "llm-agent",
    "autonomous-agent",
    "agentic-ai",
    "tool-calling",
    "multi-channel",
    "discord-bot",
    "whatsapp-bot",
    "chatbot",
    "llm",
    "groq",
    "openai",
    "anthropic",
    "claude",
    "grok",
    "ollama",
    "github-copilot",
    "mcp",
    "model-context-protocol",
    "typescript",
    "nodejs",
    "local-first",
    "self-hosted",
    "open-source"
  ],
  "author": "Artifact Virtual <hello@artifactvirtual.com> (https://artifactvirtual.com)",
  "license": "MIT",
  "homepage": "https://github.com/artifact-opensource/symbiote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artifact-opensource/symbiote.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/artifact-opensource/symbiote/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@trycua/cua-driver": "^0.36.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.7.2",
    "rcedit": "^4.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "undici": ">=6.23.0 <7"
  }
