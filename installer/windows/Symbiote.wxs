<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*"
           Name="Symbiote"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Artifact Virtual"
           UpgradeCode="{A2064B1D-594B-49F4-8447-4B5E3ABFC03C}">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Symbiote is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="SYMBIOTE_SEED_DIRECTORY" Secure="yes" />
    <UIRef Id="WixUI_InstallDir" />
    <Icon Id="SymbioteApplicationIcon" SourceFile="$(var.AppSource)\desktop\app-icon.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Symbiote" />
      </Directory>
      <Directory Id="CommonProgramsFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Symbiote" />
      </Directory>
      <Directory Id="CommonDesktopFolder" />
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DATAFOLDER" Name="Symbiote">
          <Directory Id="WORKSPACEFOLDER" Name="workspace">
            <Directory Id="SESSIONFOLDER" Name=".session" />
          </Directory>
          <Directory Id="LOGFOLDER" Name="logs" />
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="Symbiote" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="PersistentData" />
      <ComponentRef Id="WorkspaceDirectory" />
      <ComponentRef Id="SessionsDirectory" />
      <ComponentRef Id="LogsDirectory" />
      <ComponentRef Id="GatewayService" />
      <ComponentRef Id="ElectronExecutableComponent" />
    </Feature>

    <DirectoryRef Id="DATAFOLDER">
      <Component Id="PersistentData" Guid="{98F35DF6-898D-49C4-B31A-2DB99E9E0FA2}" Permanent="yes" NeverOverwrite="yes" Win64="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\Artifact Virtual\Symbiote"
                       Name="DataDirectory"
                       Type="string"
                       Value="[DATAFOLDER]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ElectronRuntimeFolder">
      <Component Id="ElectronExecutableComponent" Guid="{A61D76D1-676E-44C5-81A4-24F09F0E93E6}" Win64="yes">
        <File Id="ElectronExecutable"
              Name="electron.exe"
              Source="$(var.AppSource)\electron-runtime\electron.exe"
              KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="Symbiote"
                  Target="[INSTALLFOLDER]electron-runtime\electron.exe"
                  Icon="SymbioteApplicationIcon"
                  IconIndex="0"
                  Arguments="&quot;[INSTALLFOLDER]desktop\main.cjs&quot;"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="no" />
        <Shortcut Id="DesktopShortcut"
                  Directory="CommonDesktopFolder"
                  Name="Symbiote"
                  Target="[INSTALLFOLDER]electron-runtime\electron.exe"
                  Icon="SymbioteApplicationIcon"
                  IconIndex="0"
                  Arguments="&quot;[INSTALLFOLDER]desktop\main.cjs&quot;"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="no" />
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="LaunchSymbioteSetup"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]node.exe&quot; &quot;[INSTALLFOLDER]dist\index.js&quot; init --ui --config-dir=&quot;[DATAFOLDER]&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <DirectoryRef Id="WORKSPACEFOLDER">
      <Component Id="WorkspaceDirectory" Guid="{CB4F7E36-3884-4D3F-A1F4-7E90C5D9D9ED}" Permanent="yes" Win64="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\Artifact Virtual\Symbiote"
                       Name="WorkspaceDirectory"
                       Type="string"
                       Value="[WORKSPACEFOLDER]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="SESSIONFOLDER">
      <Component Id="SessionsDirectory" Guid="{D92D7853-45D9-4B7B-A1D7-4953487EF17E}" Permanent="yes" Win64="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\Artifact Virtual\Symbiote"
                       Name="SessionsDirectory"
                       Type="string"
                       Value="[SESSIONFOLDER]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="LOGFOLDER">
      <Component Id="LogsDirectory" Guid="{901EA3A7-1A5C-469B-8DFD-AE2548D6900F}" Permanent="yes" Win64="yes">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\Artifact Virtual\Symbiote"
                       Name="LogsDirectory"
                       Type="string"
                       Value="[LOGFOLDER]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="GatewayService" Guid="{1EED58B8-5795-4F92-9510-52DE45A9CC20}" Win64="yes">
        <File Id="NssmExecutable"
              Name="nssm.exe"
              Source="$(var.NssmSource)"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="InstallSymbioteService"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\windows\install-service.ps1&quot; -SeedDirectory &quot;[SYMBIOTE_SEED_DIRECTORY]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <CustomAction Id="UninstallSymbioteService"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\windows\uninstall-service.ps1&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="InstallSymbioteService" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="UninstallSymbioteService" Before="RemoveFiles">REMOVE~=&quot;ALL&quot;</Custom>
      <Custom Action="LaunchSymbioteSetup" After="InstallFinalize">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
