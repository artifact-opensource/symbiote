# Symbiote environment template. Copy to .env (or run `symbiote init`) and never commit the result.

# LLM provider keys — set the one you use
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# HTTP API — generate a long random value; required if the API is not bound to loopback
SYMBIOTE_API_KEY=
SYMBIOTE_API_PORT=3006
SYMBIOTE_API_HOST=127.0.0.1
SYMBIOTE_PORT=3009
SYMBIOTE_WEB_HOST=0.0.0.0
SYMBIOTE_WEB_TOKEN=
XMCP_PORT=9999

# Local n8n REST API. Defaults to http://127.0.0.1:5678/api/v1.
# Requires a separate key created in n8n's Settings > n8n API.
# An endpoint/API key saved in Integrations explicitly overrides this connection.
N8N_API_KEY=
# N8N_BASE_URL=http://127.0.0.1:5678/api/v1

# Optional remote n8n MCP server. This is separate from the REST API key.
# N8N_MCP_URL=https://your-instance.app.n8n.cloud/mcp-server/http
# N8N_MCP_KEY=
# N8N_MCP_TOKEN=  # accepted alias for N8N_MCP_KEY

# Optional runtime switches
# SYMBIOTE_LOG=debug            show internal subsystem logs
# SYMBIOTE_SANDBOX=1            restrict tools for non-owner sessions
# SYMBIOTE_INJECTION_GUARD=strict   standard | strict | off
# SYMBIOTE_SHELL=               override the shell used by exec
