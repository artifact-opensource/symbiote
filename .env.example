# Symbiote environment template. Copy to .env (or run `symbiote init`) and never commit the result.

# LLM provider keys — set the one you use
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# HTTP API — generate a long random value; required if the API is not bound to loopback
SYMBIOTE_API_KEY=
SYMBIOTE_API_PORT=3006
SYMBIOTE_API_HOST=127.0.0.1
SYMBIOTE_PORT=3009
SYMBIOTE_WEB_HOST=127.0.0.1

# Optional runtime switches
# SYMBIOTE_LOG=debug            show internal subsystem logs
# SYMBIOTE_SANDBOX=1            restrict tools for non-owner sessions
# SYMBIOTE_INJECTION_GUARD=strict   standard | strict | off
# SYMBIOTE_SHELL=               override the shell used by exec
